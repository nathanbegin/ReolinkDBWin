<Window x:Class="ReolinkDBWin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReolinkDBWin.Controls"
        Title="Paramètres"
        Width="780" Height="680" MinWidth="620" MinHeight="520"
        Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click" />
                    <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="SaveButton_Click" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Margin="0">
                    <Hyperlink Click="OpenDataFolder_Click">Ouvrir le dossier de configuration et du journal</Hyperlink>
                </TextBlock>
            </DockPanel>
        </Border>

        <TabControl Margin="10" Padding="16,12">
            <!-- ====================================================== Sonnette -->
            <TabItem Header="Sonnette">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Connexion à la sonnette Reolink" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Utilisez « Rechercher sur le réseau » pour trouver la sonnette automatiquement, ou saisissez son adresse IP. Les identifiants sont ceux de l'application Reolink (utilisateur « admin » par défaut). Le mot de passe est chiffré avec votre compte Windows." />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Adresse IP / hôte" Style="{StaticResource FieldLabel}" />
                            <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button DockPanel.Dock="Right" Content="Rechercher sur le réseau…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="DiscoverButton_Click" />
                                <TextBox x:Name="ReolinkHost" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" Text="Utilisateur" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ReolinkUser" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Text="Mot de passe" Style="{StaticResource FieldLabel}" />
                            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="ReolinkPassword" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Text="Protocole / port" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ReolinkHttps" Content="HTTPS" Margin="0,0,16,0" />
                                <TextBlock Text="Port HTTP(S)" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                <TextBox x:Name="ReolinkPort" Width="60" ToolTip="Vide = 80 (HTTP) ou 443 (HTTPS)" />
                                <TextBlock Text="Port RTSP" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" />
                                <TextBox x:Name="ReolinkRtspPort" Width="60" />
                                <TextBlock Text="Canal" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" />
                                <TextBox x:Name="ReolinkChannel" Width="40" ToolTip="0 pour une sonnette ; numéro du canal si elle est reliée à un NVR / Home Hub" />
                            </StackPanel>

                            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="ReolinkAcceptCert" Content="Accepter le certificat auto-signé de l'appareil (HTTPS)" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="150,10,0,0">
                            <Button Content="Tester la connexion" Style="{StaticResource PrimaryButton}" Click="TestReolinkButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ReolinkTestResult" Margin="150,8,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Événements de la sonnette" Style="{StaticResource SectionHeader}" Margin="0,18,0,8" />
                        <CheckBox x:Name="ReolinkMonitor" Content="Surveiller directement la sonnette (appui sur le bouton, personne, véhicule, animal, colis, mouvement)" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Intervalle d'interrogation (ms)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ReolinkPoll" Width="70" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="L'appui sur le bouton est détecté via la commande GetEvents (firmware récent). Sur un firmware plus ancien, seules les détections IA et le mouvement sont disponibles : utilisez alors Home Assistant pour l'appui sur le bouton." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== Vidéo -->
            <TabItem Header="Vidéo en direct">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Source du flux vidéo" Style="{StaticResource SectionHeader}" />
                        <RadioButton x:Name="StreamMain" GroupName="stream" Content="Sonnette — flux principal (haute qualité)" Margin="0,3" />
                        <RadioButton x:Name="StreamSub" GroupName="stream" Content="Sonnette — flux secondaire (léger, recommandé en Wi-Fi faible)" Margin="0,3" />
                        <RadioButton x:Name="StreamFrigate" GroupName="stream" Content="Restream go2rtc de Frigate (ne sollicite pas la sonnette)" Margin="0,3" />
                        <StackPanel Orientation="Horizontal" Margin="24,4,0,4">
                            <TextBlock Text="Nom du flux" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FrigateStreamName" Width="180" IsEditable="True" ToolTip="Nom du flux dans la section go2rtc de Frigate (par défaut : nom de la caméra)" />
                            <Button Content="Charger les flux" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="6,0,0,0" Click="LoadGo2RtcStreams_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,4">
                            <TextBlock Text="Flux léger" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FrigateLightStreamName" Width="180" IsEditable="True"
                                      ToolTip="Facultatif : sous-flux go2rtc (ex. sonnette_sub) utilisé quand la vidéo est petite (qualité adaptative)" />
                        </StackPanel>
                        <Border Margin="24,4,0,4" Padding="10,8" Background="{StaticResource PanelBrush}" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Serveur RTSP go2rtc (utilisé aussi par l'onglet Caméras)" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <WrapPanel>
                                    <TextBlock Text="Hôte RTSP" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <TextBox x:Name="FrigateRtspHost" Width="150" Margin="0,0,14,4"
                                             ToolTip="IP locale du serveur Frigate (ex. 192.168.1.10). Vide = hôte de l'adresse Frigate." />
                                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <TextBox x:Name="FrigateRtspPort" Width="55" Margin="0,0,14,4" />
                                    <TextBlock Text="Utilisateur" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <TextBox x:Name="FrigateRtspUser" Width="90" Margin="0,0,10,4" ToolTip="Seulement si go2rtc › rtsp › username est défini" />
                                    <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <PasswordBox x:Name="FrigateRtspPassword" Width="90" Margin="0,0,0,4" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Si Frigate est derrière un proxy inverse ou un nom de domaine (HTTPS), le port RTSP 8554 n'est généralement pas relayé : indiquez ici l'IP locale du serveur Frigate." />
                            </StackPanel>
                        </Border>
                        <RadioButton x:Name="StreamCustom" GroupName="stream" Content="URL personnalisée (RTSP, RTMP, HTTP-FLV…)" Margin="0,3" />
                        <TextBox x:Name="CustomUrl" Margin="24,4,0,4" />
                        <TextBlock x:Name="StreamPreview" Style="{StaticResource Hint}" Margin="0,8,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Tester le flux" Style="{StaticResource PrimaryButton}" Click="TestStream_Click" />
                            <TextBlock x:Name="StreamTestResult" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="520" />
                        </StackPanel>

                        <TextBlock Text="Lecture" Style="{StaticResource SectionHeader}" Margin="0,12,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tampon réseau (ms)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NetworkCaching" Width="70" />
                            <TextBlock Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center" Text="Plus bas = moins de délai ; plus haut = image plus stable." />
                        </StackPanel>
                        <CheckBox x:Name="UseTcp" Content="Forcer RTSP sur TCP (plus fiable en Wi-Fi)" Margin="0,8,0,3" />
                        <CheckBox x:Name="StartMuted" Content="Démarrer sans le son" />
                        <CheckBox x:Name="KeepAlive" Content="Garder le flux ouvert quand le widget est masqué (affichage instantané, mais consomme de la bande passante)" />
                        <CheckBox x:Name="WidgetTopmost" Content="Widget toujours au premier plan" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== Caméras -->
            <TabItem Header="Caméras">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Mode d'affichage du widget" Style="{StaticResource SectionHeader}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeSingle" GroupName="mode" Content="Une caméra" Margin="0,0,18,0" />
                            <RadioButton x:Name="ModeGrid" GroupName="mode" Content="Mosaïque" Margin="0,0,18,0" />
                            <RadioButton x:Name="ModeCarousel" GroupName="mode" Content="Défilement automatique" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,6" Text="Défilement : pendant qu'une caméra est affichée, la suivante est déjà ouverte en arrière-plan ; le changement n'a lieu que lorsqu'elle affiche l'image, avec sa transition. Une caméra qui ne répond pas est sautée. Dans le widget : ← → changer, P pause, V mode, molette = zoom." />
                        <WrapPanel>
                            <TextBlock Text="Colonnes de la mosaïque" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                            <TextBox x:Name="GridColumns" Width="40" ToolTip="0 = automatique" Margin="0,0,18,0" />
                            <TextBlock Text="Attente max. d'une caméra (s)" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                            <TextBox x:Name="MaxWait" Width="40" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox x:Name="JumpOnDetection" Content="Mettre en avant les caméras d'une détection (mosaïque si plusieurs), au moins" VerticalAlignment="Center" ToolTip="Tant qu'un événement Frigate est en cours, la caméra reste en avant" />
                            <TextBox x:Name="DetectionHold" Width="40" Margin="6,0" />
                            <TextBlock Text="secondes" VerticalAlignment="Center" />
                        </StackPanel>
                        <WrapPanel Margin="0,2,0,0">
                            <CheckBox x:Name="EnableZoom" Content="Zoom à la molette (glisser pour se déplacer)" Margin="0,3,6,3" />
                            <TextBlock Text="max." Style="{StaticResource FieldLabel}" Margin="0,0,4,0" />
                            <TextBox x:Name="MaxZoom" Width="36" Margin="0,0,18,0" />
                            <CheckBox x:Name="ShowLed" Content="Voyant d'état (vert = en direct)" Margin="0,3,18,3" />
                            <CheckBox x:Name="ShowNames" Content="Noms des caméras" Margin="0,3,18,3" />
                            <CheckBox x:Name="AdaptiveQuality" Content="Qualité adaptative (économise mémoire et processeur)"
                                      ToolTip="Flux léger et décodage à la taille affichée ; passage sans coupure en haute qualité quand la vidéo est agrandie ou zoomée" />
                        </WrapPanel>
                        <Separator Margin="0,8" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="Ajouter" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,0,4,4" Click="AddCamera_Click" />
                                <Button Content="Retirer" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,0,4,4" Click="RemoveCamera_Click" />
                                <Button Content="▲" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,0,4,4" Click="MoveUp_Click" ToolTip="Monter" />
                                <Button Content="▼" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,0,4,4" Click="MoveDown_Click" ToolTip="Descendre" />
                                <Button Content="Importer de Frigate" Style="{StaticResource SecondaryButton}" MinWidth="0" Margin="0,0,4,4" Click="ImportFrigate_Click" />
                            </WrapPanel>
                            <ListBox x:Name="CameraList" MinHeight="120">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0">
                                            <TextBlock Text="{Binding Name}" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="CameraEditor" DataContext="{Binding SelectedItem, ElementName=CameraList}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Nom" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="{Binding SourceIndex}">
                                    <ComboBoxItem Content="Sonnette (onglets Sonnette et Vidéo)" />
                                    <ComboBoxItem Content="Flux go2rtc de Frigate" />
                                    <ComboBoxItem Content="URL (RTSP, RTMP, HTTP…)" />
                                </ComboBox>
                                <TextBlock Grid.Row="2" Text="Flux go2rtc / URL" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding HasAddress}" ToolTip="Nom du flux go2rtc (ex. cour) ou URL complète (ex. rtsp://user:mdp@192.168.1.20:554/h264Preview_01_sub)" />
                                <TextBlock Grid.Row="3" Text="Caméra Frigate / flux léger" Style="{StaticResource FieldLabel}" />
                                <DockPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBox DockPanel.Dock="Right" Width="130" Margin="6,0,0,0" Text="{Binding LightAddress, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding HasAddress}" ToolTip="Flux léger facultatif : nom go2rtc (ex. cour_sub) ou URL du sous-flux" />
                                <TextBox VerticalAlignment="Center" Text="{Binding FrigateCamera, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nom de la caméra dans Frigate, pour associer les détections (vide = nom du flux)" />
                                </DockPanel>
                                <TextBlock Grid.Row="4" Text="Durée d'affichage (s)" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="1" Width="60" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding DwellSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="5" Text="Transition d'arrivée" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="5" Grid.Column="1" Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" SelectedIndex="{Binding TransitionIndex}">
                                    <ComboBoxItem Content="Coupure nette" />
                                    <ComboBoxItem Content="Fondu" />
                                    <ComboBoxItem Content="Glissement" />
                                    <ComboBoxItem Content="Zoom + fondu" />
                                </ComboBox>
                                <TextBlock Grid.Row="6" Text="Durée transition (ms)" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="6" Grid.Column="1" Width="60" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding TransitionMs, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Notify}" Content="Notifier aussi les détections Frigate de cette caméra" />
                                <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Tester cette caméra" Style="{StaticResource SecondaryButton}" Click="TestCamera_Click" />
                                    <TextBlock x:Name="CameraTestResult" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="320" />
                                </StackPanel>
                                <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Astuce : pour ménager le Wi-Fi et le processeur en mosaïque, utilisez les flux secondaires (…_sub) ou les flux go2rtc de Frigate." />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ====================================================== Notifications -->
            <TabItem Header="Notifications">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox x:Name="NotifEnabled" Content="Afficher des notifications" FontWeight="SemiBold" />

                        <TextBlock Text="Style" Style="{StaticResource SectionHeader}" Margin="0,14,0,6" />
                        <RadioButton x:Name="StylePopup" GroupName="notifstyle" Margin="0,3"
                                     Content="Fenêtre d'alerte Vigie : image entière et vidéo en direct de la caméra concernée (recommandé)" />
                        <StackPanel Orientation="Horizontal" Margin="24,2,0,4">
                            <TextBlock Text="Durée d'affichage (s)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PopupSeconds" Width="50" ToolTip="La sonnette reste affichée au moins 60 secondes" />
                        </StackPanel>
                        <RadioButton x:Name="StyleWindows" GroupName="notifstyle" Margin="0,3"
                                     Content="Notification Windows (centre de notifications, respecte « Ne pas déranger »)" />

                        <TextBlock Text="Sources" Style="{StaticResource SectionHeader}" Margin="0,14,0,6" />
                        <CheckBox x:Name="NotifReolink" Content="Sonnette Reolink (directement)" />
                        <CheckBox x:Name="NotifFrigate" Content="Frigate (détections d'objets, avec vignette et accès au clip)" />
                        <CheckBox x:Name="NotifHa" Content="Home Assistant (entités sélectionnées dans l'onglet Home Assistant)" />
                        <TextBlock Style="{StaticResource Hint}" Text="Si plusieurs sources signalent le même type d'événement, une seule notification est affichée pendant le délai anti-rafale." />

                        <TextBlock Text="Types d'événements" Style="{StaticResource SectionHeader}" Margin="0,10,0,6" />
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="TypeDoorbell" Content="🔔 Appui sur la sonnette" />
                            <CheckBox x:Name="TypePerson" Content="🧍 Personne" />
                            <CheckBox x:Name="TypeVehicle" Content="🚗 Véhicule" />
                            <CheckBox x:Name="TypeAnimal" Content="🐾 Animal" />
                            <CheckBox x:Name="TypePackage" Content="📦 Colis" />
                            <CheckBox x:Name="TypeFace" Content="🙂 Visage" />
                            <CheckBox x:Name="TypeMotion" Content="👀 Mouvement" />
                            <CheckBox x:Name="TypeOther" Content="Autres objets" />
                        </UniformGrid>

                        <TextBlock Text="Comportement" Style="{StaticResource SectionHeader}" Margin="0,10,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Délai anti-rafale (secondes)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="Cooldown" Width="60" />
                        </StackPanel>
                        <CheckBox x:Name="IncludeSnapshot" Content="Inclure une image dans la notification" Margin="0,8,0,3" />
                        <CheckBox x:Name="OpenLiveOnDoorbell" Content="Ouvrir automatiquement le widget vidéo quand quelqu'un sonne" />
                        <CheckBox x:Name="OpenLiveOnDetection" Content="Ouvrir aussi le widget lors d'une détection (personne, objet…), centré sur la ou les caméras concernées" />
                        <CheckBox x:Name="NotifSound" Content="Son de notification" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Envoyer une notification de test" Style="{StaticResource SecondaryButton}" Click="TestNotificationButton_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Si rien ne s'affiche, vérifiez Paramètres Windows › Système › Notifications (et le mode Ne pas déranger)." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== Frigate -->
            <TabItem Header="Frigate">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Serveur Frigate" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Ex. http://192.168.1.10:5000 (accès interne sans authentification) ou https://192.168.1.10:8971 (avec utilisateur et mot de passe, Frigate 0.14+)." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="FrigateUrl" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="Utilisateur" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="FrigateUser" VerticalAlignment="Center" ToolTip="Laisser vide pour le port 5000" />
                            <TextBlock Grid.Row="2" Text="Mot de passe" Style="{StaticResource FieldLabel}" />
                            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="FrigatePassword" VerticalAlignment="Center" />
                            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="FrigateAcceptCert" Content="Accepter un certificat auto-signé" />
                            <TextBlock Grid.Row="4" Text="Caméra de la sonnette" Style="{StaticResource FieldLabel}" />
                            <DockPanel Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
                                <Button DockPanel.Dock="Right" Content="Tester et charger les caméras" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="TestFrigateButton_Click" />
                                <ComboBox x:Name="FrigateCamera" IsEditable="True" />
                            </DockPanel>
                        </Grid>
                        <TextBlock x:Name="FrigateTestResult" Margin="150,8,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Notifications Frigate" Style="{StaticResource SectionHeader}" Margin="0,16,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Intervalle d'interrogation (s)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="FrigatePoll" Width="60" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Objets à notifier" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="FrigateLabels" Width="300" ToolTip="Séparés par des virgules (ex. person, car, package). Vide = tous." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Noms d'objets Frigate en anglais, séparés par des virgules (person, car, dog, cat, package…). Vide = tous les objets suivis." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== Home Assistant -->
            <TabItem Header="Home Assistant">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Home Assistant (facultatif)" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Permet de recevoir les événements de l'intégration Reolink de Home Assistant (ex. binary_sensor.sonnette_visiteur) en temps réel. Créez un jeton d'accès longue durée dans votre profil Home Assistant (onglet Sécurité)." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Adresse" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="HaUrl" VerticalAlignment="Center" ToolTip="Ex. http://homeassistant.local:8123" />
                            <TextBlock Grid.Row="1" Text="Jeton d'accès" Style="{StaticResource FieldLabel}" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="HaToken" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox x:Name="HaAcceptCert" Content="Accepter un certificat auto-signé" Margin="0,0,16,0" />
                                <Button Content="Tester et charger les entités" Style="{StaticResource SecondaryButton}" Click="LoadHaEntitiesButton_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="HaTestResult" Margin="150,8,0,0" TextWrapping="Wrap" />
                        <DockPanel Margin="0,10,0,4">
                            <TextBlock Text="Entités surveillées" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox x:Name="HaFilter" DockPanel.Dock="Right" Width="200" HorizontalAlignment="Right" TextChanged="HaFilter_TextChanged" ToolTip="Filtrer" />
                        </DockPanel>
                    </StackPanel>
                    <ListBox x:Name="HaEntities" MinHeight="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0">
                                    <TextBlock>
                                        <Run Text="{Binding FriendlyName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="{Binding EntityId, Mode=OneWay}" Foreground="#8A94A3" />
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- ====================================================== Général -->
            <TabItem Header="Général">
                <StackPanel>
                    <TextBlock Text="Raccourcis clavier globaux" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource Hint}" Text="Cliquez dans le champ puis appuyez sur la combinaison voulue (au moins une touche Ctrl, Alt, Maj ou Win). Retour arrière pour effacer." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Afficher / masquer le widget vidéo" Style="{StaticResource FieldLabel}" />
                        <controls:HotkeyBox Grid.Column="1" x:Name="HotkeyLive" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Ouvrir l'historique Frigate" Style="{StaticResource FieldLabel}" />
                        <controls:HotkeyBox Grid.Row="1" Grid.Column="1" x:Name="HotkeyHistory" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="Démarrage" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                    <CheckBox x:Name="StartWithWindows" Content="Lancer automatiquement à l'ouverture de session Windows" />

                    <TextBlock Text="Mises à jour" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                    <CheckBox x:Name="AutoUpdate" Content="Vérifier automatiquement les nouvelles versions (une fois par jour)" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Rechercher maintenant" Style="{StaticResource SecondaryButton}" Click="CheckUpdates_Click" />
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="À propos" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="LicenseStatusText" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Gérer la licence…" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ManageLicense_Click" />
                        <Button Content="Site GitHub" Style="{StaticResource SecondaryButton}" Click="GitHub_Click" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
