<Window x:Class="ReolinkDBWin.Views.LiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReolinkDBWin.Controls"
        Title="Vidéo en direct"
        Width="480" Height="380" MinWidth="240" MinHeight="180"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="Black" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="CloseCommand_Executed" />
    </Window.CommandBindings>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barre de titre (déplacement de la fenêtre) -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource BarBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True" Margin="8,0,2,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PrevButton" Style="{StaticResource BarButton}" ToolTip="Caméra précédente (←)" Click="PrevButton_Click" Content="&#xE76B;" />
                        <Button x:Name="PauseButton" Style="{StaticResource BarButton}" ToolTip="Pause du défilement (P)" Click="PauseButton_Click" Content="&#xE769;" />
                        <Button x:Name="NextButton" Style="{StaticResource BarButton}" ToolTip="Caméra suivante (→)" Click="NextButton_Click" Content="&#xE76C;" />
                        <Button x:Name="ModeButton" Style="{StaticResource BarButton}" ToolTip="Mode d'affichage (V)" Click="ModeButton_Click" Content="&#xE80A;" />
                        <Button x:Name="MuteButton" Style="{StaticResource BarButton}" ToolTip="Son (M)" Click="MuteButton_Click" Content="&#xE74F;" />
                        <Button Style="{StaticResource BarButton}" ToolTip="Capture d'écran (S)" Click="SnapshotButton_Click" Content="&#xE722;" />
                        <Button Style="{StaticResource BarButton}" ToolTip="Historique Frigate" Click="HistoryButton_Click" Content="&#xE81C;" />
                        <!-- Premier plan / arrière-plan : la fenêtre pleine (en bas à droite) est la nôtre -->
                        <Button x:Name="PinButton" Style="{StaticResource BarButton}" Click="PinButton_Click">
                            <Canvas Width="16" Height="13">
                                <Rectangle x:Name="PinOther" Canvas.Left="0" Canvas.Top="0" Width="10" Height="8" RadiusX="1.5" RadiusY="1.5"
                                           Stroke="#F2F4F7" StrokeThickness="1.3" />
                                <Rectangle x:Name="PinOurs" Canvas.Left="5.5" Canvas.Top="4.5" Width="10" Height="8" RadiusX="1.5" RadiusY="1.5"
                                           Stroke="#F2F4F7" StrokeThickness="1.3" />
                            </Canvas>
                        </Button>
                        <Button Style="{StaticResource BarButton}" ToolTip="Paramètres" Click="SettingsButton_Click" Content="&#xE713;" />
                        <Button Style="{StaticResource CloseBarButton}" ToolTip="Masquer (Échap)" Click="CloseButton_Click" Content="&#xE711;" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Sonnette" Foreground="{StaticResource BarForeground}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ClockText" Foreground="{StaticResource MutedForeground}" Margin="10,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Zone vidéo -->
            <Grid x:Name="ViewHost" Grid.Row="1" ClipToBounds="True" Background="Black"
                  MouseLeftButtonDown="ViewHost_MouseLeftButtonDown" MouseMove="ViewHost_MouseMove">
                <!-- Une caméra / défilement : deux calques pour des transitions sans écran de chargement -->
                <Grid x:Name="Stage">
                    <controls:CameraTile x:Name="TileA" />
                    <controls:CameraTile x:Name="TileB" Visibility="Collapsed" />
                </Grid>

                <!-- Mosaïque -->
                <UniformGrid x:Name="GridPanel" Visibility="Collapsed" />

                <!-- Vue d'alerte : caméra(s) avec une détection, au premier plan (mosaïque si plusieurs) -->
                <Grid x:Name="AlertLayer" Visibility="Collapsed" Background="Black">
                    <UniformGrid x:Name="AlertPanel" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="7,2" CornerRadius="3"
                            Background="#CC1676D6" IsHitTestVisible="False">
                        <TextBlock x:Name="AlertBadgeText" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- Indicateurs du défilement -->
                <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,7" IsHitTestVisible="False" Opacity="0.8" />
                <Rectangle x:Name="ProgressLine" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                           Fill="#80FFFFFF" Width="0" IsHitTestVisible="False" />

                <!-- Message global (configuration manquante, licence) -->
                <Border x:Name="OverlayPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#B0000000" CornerRadius="6" Padding="16,10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="OverlayText" Foreground="White" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                        <Button x:Name="OverlayButton" Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}"
                                Click="OverlayButton_Click" Content="Configurer" />
                    </StackPanel>
                </Border>

                <Border x:Name="EventBanner" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="8,30,8,8"
                        Background="#E61676D6" CornerRadius="4" Padding="10,6" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="EventBannerText" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
