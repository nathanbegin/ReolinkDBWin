<Window x:Class="ReolinkDBWin.Views.DiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rechercher une sonnette Reolink"
        Width="640" Height="440" MinWidth="480" MinHeight="320"
        Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="Recherche des appareils Reolink sur le réseau local (ONVIF et API HTTP). Si un mot de passe est saisi dans les paramètres, chaque appareil est identifié (nom et modèle)." />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RescanButton" Content="Relancer" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RescanButton_Click" />
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="UseButton" Content="Utiliser cet appareil" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="UseButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar x:Name="Progress" Width="80" Height="6" IsIndeterminate="True" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedForeground}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
            </StackPanel>
        </DockPanel>
        <ListView x:Name="Results" SelectionMode="Single" SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Adresse" Width="120" DisplayMemberBinding="{Binding Host}" />
                    <GridViewColumn Header="Nom" Width="140" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Modèle" Width="170" DisplayMemberBinding="{Binding Model}" />
                    <GridViewColumn Header="Reolink" Width="60" DisplayMemberBinding="{Binding ReolinkText}" />
                    <GridViewColumn Header="Info" Width="120" DisplayMemberBinding="{Binding Info}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
