<Window x:Class="ReolinkDBWin.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Licence"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="pack://application:,,,/Assets/app.png" Width="48" Height="48" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProductText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="TaglineText" Style="{StaticResource Hint}" Margin="0" />
            </StackPanel>
        </StackPanel>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="LicenseeText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="Clé de licence" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="KeyBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 FontFamily="Consolas" FontSize="11" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <DockPanel Margin="0,14,0,0">
            <Button x:Name="DeactivateButton" DockPanel.Dock="Left" Content="Retirer la licence de ce PC" Style="{StaticResource SecondaryButton}" Click="DeactivateButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BuyButton" Content="Acheter / renouveler" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BuyButton_Click" />
                <Button x:Name="CloseButton" Content="Fermer" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsCancel="True" Click="CloseButton_Click" />
                <Button Content="Activer" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="ActivateButton_Click" />
            </StackPanel>
        </DockPanel>

        <Separator Margin="0,16,0,10" />
        <TextBlock Style="{StaticResource Hint}" Margin="0">
            <Run x:Name="CreditsRun" />
            <LineBreak />
            <Hyperlink x:Name="GitHubLink" Click="GitHubLink_Click"><Run x:Name="GitHubRun" /></Hyperlink>
        </TextBlock>
    </StackPanel>
</Window>
