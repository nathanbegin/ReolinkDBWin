<Window x:Class="ReolinkDBWin.Views.NotificationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ReolinkDBWin.Controls"
        Title="Alerte" Width="424" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI">
    <Border Margin="12" CornerRadius="10" Background="#F51B1F24" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <StackPanel>
                <!-- En-tête -->
                <DockPanel Margin="14,10,6,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseBarButton}" Content="&#xE711;" ToolTip="Fermer" Click="DismissButton_Click" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubText" Foreground="{StaticResource MutedForeground}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <!-- Image entière (16:9, sans rognage) : instantané, remplacé par le direct dès qu'il est prêt -->
                <Grid x:Name="MediaArea" Height="225" Background="Black" Cursor="Hand" MouseLeftButtonUp="MediaArea_MouseLeftButtonUp" ToolTip="Ouvrir le widget">
                    <Image x:Name="SnapshotImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <controls:CameraTile x:Name="LiveTile" Background="Transparent" />
                    <Border x:Name="LiveBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,1"
                            CornerRadius="3" Background="#CCE5484D" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="EN DIRECT" Foreground="White" FontSize="10" FontWeight="Bold" />
                    </Border>
                </Grid>

                <!-- Actions (sous l'image : rien ne la recouvre) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,10,10,12">
                    <Button x:Name="ClipButton" Content="Voir le clip" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ClipButton_Click" />
                    <Button Content="Ignorer" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DismissButton_Click" />
                    <Button Content="Ouvrir le widget" Style="{StaticResource PrimaryButton}" Click="OpenButton_Click" />
                </StackPanel>
            </StackPanel>
            <!-- Temps restant avant fermeture -->
            <Rectangle x:Name="Countdown" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,10,1"
                       Fill="#661676D6" RadiusX="1" RadiusY="1" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
