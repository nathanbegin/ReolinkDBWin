<Window x:Class="ReolinkDBWin.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Historique des événements — Frigate"
        Width="1180" Height="720" MinWidth="820" MinHeight="480"
        Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel>
        <!-- Filtres -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="12,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Caméra" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                <ComboBox x:Name="CameraCombo" Width="150" Margin="0,0,16,0" />
                <TextBlock Text="Objet" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                <ComboBox x:Name="LabelCombo" Width="150" Margin="0,0,16,0" DisplayMemberPath="Display" />
                <TextBlock Text="Période" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                <ComboBox x:Name="RangeCombo" Width="140" Margin="0,0,8,0" SelectionChanged="RangeCombo_SelectionChanged">
                    <ComboBoxItem Content="Dernière heure" Tag="1h" />
                    <ComboBoxItem Content="Aujourd'hui" Tag="today" />
                    <ComboBoxItem Content="24 dernières heures" Tag="24h" IsSelected="True" />
                    <ComboBoxItem Content="7 derniers jours" Tag="7d" />
                    <ComboBoxItem Content="30 derniers jours" Tag="30d" />
                    <ComboBoxItem Content="Dates personnalisées" Tag="custom" />
                </ComboBox>
                <StackPanel x:Name="CustomDates" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,16,0">
                    <TextBlock Text="du" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                    <DatePicker x:Name="FromDate" Width="120" />
                    <TextBlock Text="au" Style="{StaticResource FieldLabel}" Margin="8,0,6,0" />
                    <DatePicker x:Name="ToDate" Width="120" />
                </StackPanel>
                <CheckBox x:Name="ClipOnlyCheck" Content="Avec vidéo seulement" Margin="8,0,16,0" IsChecked="True" />
                <Button x:Name="SearchButton" Content="Rechercher" Style="{StaticResource PrimaryButton}" Click="SearchButton_Click" />
            </WrapPanel>
        </Border>

        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="12,4">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedForeground}" Text="Prêt." />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Liste des événements -->
            <DockPanel Grid.Column="0">
                <Button x:Name="MoreButton" DockPanel.Dock="Bottom" Content="Charger plus d'événements" Margin="8" Style="{StaticResource SecondaryButton}"
                        Click="MoreButton_Click" Visibility="Collapsed" />
                <ListBox x:Name="EventList" BorderThickness="0" SelectionChanged="EventList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="120" Height="68" Background="#E9EDF2" CornerRadius="3" HorizontalAlignment="Left">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding When}" Foreground="#4A5563" />
                                    <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedForeground}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrushLight}" />

            <!-- Lecteur -->
            <DockPanel Grid.Column="2" Background="Black">
                <Border DockPanel.Dock="Bottom" Background="#1B1F24" Padding="8,6">
                    <DockPanel>
                        <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource BarButton}" Content="&#xE768;" ToolTip="Lecture / pause (Espace)" Click="PlayButton_Click" IsEnabled="False" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="TimeText" Foreground="{StaticResource BarForeground}" VerticalAlignment="Center" Margin="8,0" Text="00:00 / 00:00" />
                            <ComboBox x:Name="SpeedCombo" Width="64" VerticalAlignment="Center" SelectionChanged="SpeedCombo_SelectionChanged" ToolTip="Vitesse de lecture">
                                <ComboBoxItem Content="0,5×" Tag="0.5" />
                                <ComboBoxItem Content="1×" Tag="1" IsSelected="True" />
                                <ComboBoxItem Content="2×" Tag="2" />
                                <ComboBoxItem Content="4×" Tag="4" />
                            </ComboBox>
                            <Button Style="{StaticResource BarButton}" Content="&#xE722;" ToolTip="Voir l'instantané" Click="SnapshotButton_Click" Margin="6,0,0,0" />
                            <Button x:Name="SaveButton" Style="{StaticResource BarButton}" Content="&#xE74E;" ToolTip="Enregistrer le clip…" Click="SaveButton_Click" IsEnabled="False" />
                            <Button Style="{StaticResource BarButton}" Content="&#xE7A7;" ToolTip="Ouvrir dans Frigate (navigateur)" Click="OpenInFrigate_Click" />
                        </StackPanel>
                        <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0" IsMoveToPointEnabled="True"
                                PreviewMouseDown="SeekSlider_PreviewMouseDown" PreviewMouseUp="SeekSlider_PreviewMouseUp" IsEnabled="False" />
                    </DockPanel>
                </Border>
                <vlc:VideoView x:Name="Player" Background="Black">
                    <Grid>
                        <Image x:Name="SnapshotImage" Stretch="Uniform" Visibility="Collapsed" />
                        <Border x:Name="PlayerOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#B0000000" CornerRadius="6" Padding="16,10">
                            <TextBlock x:Name="PlayerOverlayText" Foreground="White" FontSize="14" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                                       Text="Sélectionnez un événement pour voir la vidéo." />
                        </Border>
                    </Grid>
                </vlc:VideoView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
