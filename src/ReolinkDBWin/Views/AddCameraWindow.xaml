<Window x:Class="ReolinkDBWin.Views.AddCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une caméra" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico">
    <StackPanel Margin="20">
        <TextBlock Style="{StaticResource Hint}" Text="Choisissez la marque : l'adresse du flux est construite pour vous. « ONVIF » demande directement l'adresse à la caméra (toutes marques compatibles). Le mot de passe est chiffré avec votre compte Windows." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <TextBlock Text="Marque" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Column="1" x:Name="BrandCombo" VerticalAlignment="Center" DisplayMemberPath="Name" SelectionChanged="BrandCombo_SelectionChanged" />

            <TextBlock Grid.Row="1" Text="Nom" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" VerticalAlignment="Center" Text="Caméra" />

            <TextBlock Grid.Row="2" Text="Adresse IP" Style="{StaticResource FieldLabel}" />
            <DockPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                <Button DockPanel.Dock="Right" x:Name="FindButton" Content="Rechercher (ONVIF)" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="FindButton_Click"
                        ToolTip="Cherche les caméras ONVIF du réseau local, toutes marques" />
                <ComboBox x:Name="HostBox" IsEditable="True" TextBoxBase.TextChanged="Field_Changed" SelectionChanged="HostBox_SelectionChanged" />
            </DockPanel>

            <TextBlock Grid.Row="3" Text="Utilisateur" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="UserBox" VerticalAlignment="Center" Text="admin" TextChanged="Field_Changed" />

            <TextBlock Grid.Row="4" Text="Mot de passe" Style="{StaticResource FieldLabel}" />
            <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" VerticalAlignment="Center" PasswordChanged="Password_Changed" />

            <TextBlock Grid.Row="5" Text="Port / canal" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="PortBox" Width="70" TextChanged="Field_Changed" ToolTip="Port RTSP (ou port ONVIF pour la marque ONVIF)" />
                <TextBlock Text="Canal" Style="{StaticResource FieldLabel}" Margin="16,0,6,0" />
                <TextBox x:Name="ChannelBox" Width="50" Text="1" TextChanged="Field_Changed" ToolTip="1 pour une caméra seule ; numéro de la caméra sur un enregistreur" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="NotesText" Style="{StaticResource Hint}" Margin="0,8,0,0" />

        <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="10,8" Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Text="Flux principal" FontWeight="SemiBold" />
                <TextBox x:Name="MainUrlBox" Margin="0,3,0,6" FontFamily="Consolas" FontSize="11" />
                <TextBlock Text="Flux léger (facultatif — petit affichage, mosaïque, alertes)" FontWeight="SemiBold" />
                <TextBox x:Name="SubUrlBox" Margin="0,3,0,0" FontFamily="Consolas" FontSize="11" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" />

        <DockPanel Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" x:Name="ActionButton" Content="Tester le flux" Style="{StaticResource SecondaryButton}" Click="ActionButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Ajouter" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="AddButton_Click" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
