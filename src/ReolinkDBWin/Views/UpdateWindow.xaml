<Window x:Class="ReolinkDBWin.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour" Width="560" Height="460" MinWidth="440" MinHeight="320"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="pack://application:,,,/Assets/app.png" Width="40" Height="40" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0" />
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <ProgressBar x:Name="Progress" Height="6" Margin="0,10,0,0" Visibility="Collapsed" Maximum="1" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,6,0,0" />
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Ignorer cette version" Style="{StaticResource SecondaryButton}" Click="SkipButton_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PageButton" Content="Voir la page" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="PageButton_Click" />
                    <Button x:Name="LaterButton" Content="Plus tard" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsCancel="True" Click="LaterButton_Click" />
                    <Button x:Name="InstallButton" Content="Installer maintenant" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="InstallButton_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <Border BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontFamily="Segoe UI" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
