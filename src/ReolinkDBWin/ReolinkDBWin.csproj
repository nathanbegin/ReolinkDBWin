<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ReolinkDBWin</RootNamespace>
    <AssemblyName>ReolinkDBWin</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Title>Sonnette Reolink pour Windows</Title>
    <Description>Widget vidéo en direct, notifications et historique Frigate pour sonnette Reolink.</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Seuls les binaires VLC 64 bits sont nécessaires -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Éviter les conflits de noms entre WPF et WinForms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modules VLC inutiles ici (interfaces, scripts, visualisations, diffusion) -->
    <VlcWindowsX64ExcludeFiles Include="plugins\gui\%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\lua\%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\visualization\%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\stream_out\%2A" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-paused.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReolinkDBWin.Core\ReolinkDBWin.Core.csproj" />
  </ItemGroup>
</Project>
