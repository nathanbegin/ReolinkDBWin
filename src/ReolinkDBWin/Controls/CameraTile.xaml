<UserControl x:Class="ReolinkDBWin.Controls.CameraTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black" ClipToBounds="True" Focusable="False">
    <Grid x:Name="Root">
        <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" RenderTransformOrigin="0,0">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ZoomPan" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- Nom de la caméra -->
        <Border x:Name="NameBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                Background="#80000000" CornerRadius="3" Padding="6,2" IsHitTestVisible="False">
            <TextBlock x:Name="NameText" Foreground="#EEFFFFFF" FontSize="11" />
        </Border>

        <!-- État (seulement tant qu'aucune image n'est affichée) -->
        <Border x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#A0000000" CornerRadius="6" Padding="14,8" IsHitTestVisible="False">
            <TextBlock x:Name="StatusText" Foreground="White" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
        </Border>

        <!-- Voyant d'état discret : vert = en direct, orange = connexion, rouge = erreur -->
        <Ellipse x:Name="Led" Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7"
                 Fill="#8A94A3" Opacity="0.85" ToolTipService.InitialShowDelay="200">
            <Ellipse.Effect>
                <DropShadowEffect x:Name="LedGlow" ShadowDepth="0" BlurRadius="6" Color="#8A94A3" Opacity="0.9" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Niveau de zoom -->
        <Border x:Name="ZoomBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                Background="#80000000" CornerRadius="3" Padding="5,1" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ZoomText" Foreground="#EEFFFFFF" FontSize="11" />
        </Border>

        <!-- Contour animé lors d'une détection -->
        <Border x:Name="FlashBorder" BorderBrush="#2A88E8" BorderThickness="3" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</UserControl>
